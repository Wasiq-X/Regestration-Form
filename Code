import pygame
import sys
pygame.init()
WIDTH = 800
HEIGHT = 500
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Registration Form")
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
BLUE = (50, 100, 200)
GRAY = (200, 200, 200)
GREEN = (50, 180, 100)
font = pygame.font.Font(None, 45)
small_font = pygame.font.Font(None, 30)
name = ""
email = ""
password = ""
active_field = None
registered = False
name_box = pygame.Rect(300, 130, 300, 45)
email_box = pygame.Rect(300, 200, 300, 45)
password_box = pygame.Rect(300, 270, 300, 45)
register_button = pygame.Rect(300, 350, 300, 55)
running = True
while running:
    screen.fill(WHITE)
    title = font.render("REGISTRATION FORM", True, BLACK)
    screen.blit(title, (245, 50))
    name_label = small_font.render("Name", True, BLACK)
    screen.blit(name_label, (200, 140))
    email_label = small_font.render("Email", True, BLACK)
    screen.blit(email_label, (200, 210))
    password_label = small_font.render("Password", True, BLACK)
    screen.blit(password_label, (200, 280))
    pygame.draw.rect(screen, GRAY, name_box)
    pygame.draw.rect(screen, GRAY, email_box)
    pygame.draw.rect(screen, GRAY, password_box)
    name_text = small_font.render(name, True, BLACK)
    screen.blit(name_text, (name_box.x + 10, name_box.y + 8))
    email_text = small_font.render(email, True, BLACK)
    screen.blit(email_text, (email_box.x + 10, email_box.y + 8))
    password_text = "*" * len(password)
    password_surface = small_font.render(password_text, True, BLACK)
    screen.blit(password_surface, (password_box.x + 10, password_box.y + 8))
    pygame.draw.rect(screen, BLUE, register_button)
    register_text = small_font.render(
        "Register",
        True,
        WHITE
    )
    register_rect = register_text.get_rect(
        center=register_button.center
    )
    screen.blit(register_text, register_rect)
    if registered:
        success_text = small_font.render(
            "Registration Successful!",
            True,
            GREEN
        )
        screen.blit(success_text, (280, 430))
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
        if event.type == pygame.MOUSEBUTTONDOWN:
            mouse_position = event.pos
            if name_box.collidepoint(mouse_position):
                active_field = "name"
            elif email_box.collidepoint(mouse_position):
                active_field = "email"
            elif password_box.collidepoint(mouse_position):
                active_field = "password"
            elif register_button.collidepoint(mouse_position):
                if name and email and password:
                    registered = True
                    active_field = None
        if event.type == pygame.KEYDOWN:
            if active_field == "name":
                if event.key == pygame.K_BACKSPACE:
                    name = name[:-1]
                elif event.key == pygame.K_RETURN:
                    active_field = "email"
                else:
                    name += event.unicode
            elif active_field == "email":
                if event.key == pygame.K_BACKSPACE:
                    email = email[:-1]
                elif event.key == pygame.K_RETURN:
                    active_field = "password"
                else:
                    email += event.unicode
            elif active_field == "password":
                if event.key == pygame.K_BACKSPACE:
                    password = password[:-1]
                elif event.key == pygame.K_RETURN:
                    if name and email and password:
                        registered = True
                        active_field = None
                else:
                    password += event.unicode
    pygame.display.flip()
pygame.quit()
sys.exit()
